# =============================================================================
# USER ONLY — copy this file to .env and fill in values yourself.
# Agents must never read, write, or commit your .env file.
# =============================================================================

# Gemini (required for embeddings + generation)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Chroma local persistence (optional)
CHROMA_PERSIST_DIR=data/chroma/

# RAG retrieval (optional)
OAKLEY_TOP_K=5

# Embedding model (optional; default gemini-embedding-001)
OAKLEY_EMBEDDING_MODEL=models/gemini-embedding-001

# Web chat (optional)
OAKLEY_DB_PATH=data/oakley.db
OAKLEY_HOST=127.0.0.1
OAKLEY_PORT=8080
