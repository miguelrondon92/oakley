# =============================================================================
# USER ONLY — copy this file to .env and fill in values yourself.
# Agents must never read, write, or commit your .env file.
# =============================================================================

# Gemini (required for embeddings + generation)
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Chroma local persistence (optional)
CHROMA_PERSIST_DIR=data/chroma/

# RAG retrieval (optional)
OAKLEY_TOP_K=5
